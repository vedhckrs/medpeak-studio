 "sources": [
  {
   "id": "medline-sounds",
   "label": "MedlinePlus (US National Library of Medicine). Abdominal sounds (review date 9 October 2024)",
   "url": "https://medlineplus.gov/ency/article/003137.htm",
   "note": "'Abdominal sounds (bowel sounds) are made by the movement of the intestines as they push food through. The intestines are hollow, so bowel sounds echo through the abdomen much like the sounds heard from water pipes.' 'Most bowel sounds are normal. They simply mean that the gastrointestinal tract is working.' 'Most of the sounds you hear in your stomach and intestines are due to normal digestion.'"
  },
  {
   "id": "sanger-2011",
   "label": "Sanger GJ, Hellstrom PM, Naslund E. The hungry stomach: physiology, disease, and drug development opportunities. Front Pharmacol. 2011 (PMID 21927604)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/21927604/",
   "note": "'During hunger, a series of high-amplitude contractions of the stomach and small intestine (phase III), which form part of a cycle of quiescence and contractions (known as the migrating motor complex, MMC), play a \"housekeeping\" role prior to the next meal, and may contribute toward the development of hunger.'"
  },
  {
   "id": "goyal-2019",
   "label": "Goyal RK, Guo Y, Mashimo H. Advances in the physiology of gastric emptying. Neurogastroenterol Motil. 2019 (PMID 30740834)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/30740834/",
   "note": "'In the inter-digestive (fasting) period, gastric motility designed to clear the stomach of undigestible residues.' 'During the migrating front, the pylorus and duodenum remain relaxed and open to allow phase III activity to sweep food residues out of the stomach.' Read in the full text (PMC6850045)."
  }
 ],
