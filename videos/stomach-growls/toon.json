     "pose": "explain",
     "key": "pipes",
     "react": {
      "patient": "shocked"
     },
     "src": [
      "medline-sounds"
     ]
    },
    {
     "id": "D3",
     "who": "doctor",
     "text": "But here's the twist: an empty stomach isn't resting. It squeezes hard to sweep itself out.",
