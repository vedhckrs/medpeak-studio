 "sources": [
  {
   "id": "medline-belching",
   "label": "MedlinePlus (US National Library of Medicine). Belching (review date 3 July 2025)",
   "url": "https://medlineplus.gov/ency/article/003080.htm",
   "note": "'Belching is a normal process. The purpose of belching is to release air from the stomach. Every time you swallow, you also swallow air, along with fluid or food.' 'The buildup of air in the upper stomach causes the stomach to stretch. This triggers the muscle at the lower end of the esophagus (the tube that runs from your mouth to the stomach) to relax. Air then escapes up the esophagus and out of your mouth.' 'Avoid chewing gum, eating quickly, and eating gas-producing foods and beverages.'"
  },
  {
   "id": "niddk-gas",
   "label": "NIH National Institute of Diabetes and Digestive and Kidney Diseases. Symptoms and Causes of Gas in the Digestive Tract (last reviewed June 2021)",
   "url": "https://www.niddk.nih.gov/health-information/digestive-diseases/gas-digestive-tract/symptoms-causes",
   "note": "'Belching, or burping, is a release of gas from your stomach through your mouth. People typically belch up to 30 times a day.' 'Swallowing more air may lead to more gas and gas symptoms. You swallow more air when you chew gum or suck on hard candy, drink carbonated, or fizzy, drinks, eat or drink too fast'."
  }
 ],
