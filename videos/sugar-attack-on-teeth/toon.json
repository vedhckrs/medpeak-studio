   "lines": [
    {
     "id": "D1",
     "who": "kid",
     "text": "Doctor, is sugar really that bad?",
     "emotion": "sad",
     "pose": "shrug",
     "key": "sugar"
    },
    {
     "id": "D2",
     "who": "doctor",
     "text": "Mouth bacteria turn sugar into acid. And that acid attacks your enamel.",
     "emotion": "neutral",
     "pose": "explain",
     "key": "acid",
     "react": {
      "kid": "shocked"
     },
     "src": [
      "nidcr",
      "who-sugars"
     ]
    },
    {
     "id": "D3",
     "who": "doctor",
     "text": "But here's the twist: your spit fights back. Its minerals help repair enamel.",
     "emotion": "happy",
     "pose": "present",
     "key": "twist",
     "src": [
      "nidcr"
     ]
    },
    {
     "id": "D4",
     "who": "kid",
     "text": "My spit fixes my teeth?!",
     "emotion": "shocked",
     "pose": "panic",
     "key": "spit"
    },
    {
     "id": "D5",
     "who": "doctor",
     "text": "Yes, if you give it time. So snack less often between meals.",
     "emotion": "happy",
     "pose": "thumb",
     "key": "snack",
     "react": {
      "kid": "neutral"
     },
     "src": [
      "nidcr"
     ]
    },
    {
     "id": "D6",
     "who": "doctor",
     "text": "And brush twice a day with fluoride toothpaste. Fluoride helps enamel rebuild.",
     "emotion": "neutral",
     "pose": "point",
     "key": "twice",
     "react": {
      "kid": "happy"
     },
     "src": [
      "nidcr"
     ]
    }
   ]
