 "sources": [
  {
   "id": "medline-swallowed",
   "label": "MedlinePlus (US National Library of Medicine). Foreign object - swallowed (review date 8 January 2025)",
   "url": "https://medlineplus.gov/ency/article/000036.htm",
   "note": "'If the object passes through the food pipe and into the stomach without getting stuck, it will probably pass through the entire GI tract. Objects will often pass through the GI tract within a week. In most cases, the object passes through without harming the person.' The page is about swallowed objects in general (coins, beads, buttons); it does not name gum."
  },
  {
   "id": "milov-1998",
   "label": "Milov DE, Andres JM, Erhart NA, Bailey DJ. Chewing gum bezoars of the gastrointestinal tract. Pediatrics. 1998 (PMID 9685468)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/9685468/",
   "note": "'we briefly review gum-chewing complications and describe three children who developed intestinal tract and esophageal obstruction as a consequence of swallowing gum.' 'the medical literature contains very little information about the adverse effects of chewing gum.' Read from the abstract; the full text is not open."
  },
  {
   "id": "niddk-digestive",
   "label": "NIH National Institute of Diabetes and Digestive and Kidney Diseases. Your Digestive System & How it Works (last reviewed December 2017)",
   "url": "https://www.niddk.nih.gov/health-information/digestive-diseases/digestive-system-how-it-works",
   "note": "'After food enters your stomach, the stomach muscles mix the food and liquid with digestive juices. The stomach slowly empties its contents, called chyme, into your small intestine.' 'Waste products of digestion, including parts of food that are still too large, become stool.'"
  },
  {
   "id": "goyal-2019",
   "label": "Goyal RK, Guo Y, Mashimo H. Advances in the physiology of gastric emptying. Neurogastroenterol Motil. 2019 (PMID 30740834)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/30740834/",
   "note": "'In the inter-digestive (fasting) period, gastric motility designed to clear the stomach of undigestible residues.' 'During the migrating front, the pylorus and duodenum remain relaxed and open to allow phase III activity to sweep food residues out of the stomach.' Read in the full text (PMC6850045)."
  }
 ],
