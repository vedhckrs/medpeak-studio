 "sources": [
  {
   "id": "statpearls",
   "label": "Sharma M, Sharma A, Goosenberg E. Pill-Induced Esophagitis. StatPearls (NIH Bookshelf), updated 19 August 2026",
   "url": "https://pubmed.ncbi.nlm.nih.gov/31747225/",
   "note": "The injury 'usually results from a direct toxic effect of the culprit medication on the esophageal mucosa when the medication becomes lodged or dissolves slowly within the esophagus'. Symptoms (chest pain, painful or difficult swallowing) start 'within hours or days of ingestion'."
  },
  {
   "id": "zografos2009",
   "label": "Zografos GN et al. Drug-induced esophagitis. Dis Esophagus 2009;22(8):633-7 (review)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/19392845/",
   "note": "'Since 1970 more than 650 cases have been reported worldwide caused by 30 or more medications.' 'Most cases of medication-induced esophageal injury heal without intervention within a few days.'"
  },
  {
   "id": "nhs-doxycycline",
   "label": "NHS. How and when to take doxycycline (page last reviewed 5 September 2025)",
   "url": "https://www.nhs.uk/medicines/doxycycline/how-and-when-to-take-doxycycline/",
   "note": "For the antibiotic doxycycline the NHS says: 'swallow tablets or capsules whole with a glass of water while sitting or standing up' and 'avoid lying down for at least 30 minutes after taking it (this helps stop the medicine irritating your throat)'."
  }
 ],
