   "lines": [
    {
     "id": "D1",
     "who": "patient",
     "text": "Doctor, I brush every morning. Why the ache?",
     "emotion": "sad",
     "pose": "shrug",
     "key": "morning"
    },
    {
     "id": "D2",
     "who": "doctor",
     "text": "Mouth germs turn leftover food into acid. That acid attacks your enamel.",
     "emotion": "neutral",
     "pose": "explain",
     "key": "acid",
     "react": {
      "patient": "shocked"
     },
     "src": [
      "nidcr"
     ]
    },
    {
     "id": "D3",
     "who": "doctor",
     "text": "But here's the twist: by day, your spit fights the acid. In sleep, it almost stops.",
     "emotion": "happy",
     "pose": "present",
     "key": "twist",
     "src": [
      "nidcr",
      "dawes-2008"
     ]
    },
    {
     "id": "D4",
     "who": "patient",
     "text": "So night is the worst time to skip?",
     "emotion": "shocked",
     "pose": "think",
     "key": "worst"
    },
    {
     "id": "D5",
     "who": "doctor",
     "text": "Yes. The most important brushing is the one just before bed.",
     "emotion": "neutral",
     "pose": "point",
     "key": "bed",
     "src": [
      "dawes-2008",
      "nhs-teeth"
     ]
    },
    {
     "id": "D6",
     "who": "doctor",
     "text": "Night is worse because your spit sleeps. Brush last thing, two minutes, then spit, don't rinse.",
