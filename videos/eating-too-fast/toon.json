 "sources": [
  {
   "id": "niddk-gas",
   "label": "NIH National Institute of Diabetes and Digestive and Kidney Diseases. Symptoms and Causes of Gas in the Digestive Tract (last reviewed June 2021)",
   "url": "https://www.niddk.nih.gov/health-information/digestive-diseases/gas-digestive-tract/symptoms-causes",
   "note": "'Swallowing more air may lead to more gas and gas symptoms. You swallow more air when you ... eat or drink too fast'. 'Common symptoms of gas in the digestive tract include belching, bloating and distention, and passing gas.'"
  },
  {
   "id": "niddk-portions",
   "label": "NIH National Institute of Diabetes and Digestive and Kidney Diseases. Food Portions: Choosing Just Enough for You (last reviewed July 2021)",
   "url": "https://www.niddk.nih.gov/health-information/weight-management/just-enough-food-portions",
   "note": "Under 'How can I manage food portions at home?': 'Eat slowly so your brain has time to realize your stomach is full, which may take at least 15 minutes.' 'Focus on what you are eating, chew your food well'. The page also says 'Put down your fork and glass'."
  },
  {
   "id": "kokkinos-2010",
   "label": "Kokkinos A, et al. Eating slowly increases the postprandial response of the anorexigenic gut hormones, peptide YY and glucagon-like peptide-1. J Clin Endocrinol Metab. 2010 (PMID 19875483)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/19875483/",
   "note": "17 healthy men ate the same 300 ml of ice cream in 5 minutes and in 30 minutes. The fullness hormones PYY and GLP-1 rose more after the 30-minute meal. 'Eating at a physiologically moderate pace leads to a more pronounced anorexigenic gut peptide response' than eating very fast. Kept for the description; not said in the video."
  },
  {
   "id": "ohkuma-2015",
   "label": "Ohkuma T, et al. Association between eating rate and obesity: a systematic review and meta-analysis. Int J Obes. 2015 (PMID 26100137)",
   "url": "https://pubmed.ncbi.nlm.nih.gov/26100137/",
   "note": "Pooled odds ratio for obesity among people who eat quickly: 2.15 (95% CI 1.84 to 2.51). 'Eating quickly is positively associated with excess body weight.' An association, not a proven cause. Kept for the description; not said in the video."
  }
