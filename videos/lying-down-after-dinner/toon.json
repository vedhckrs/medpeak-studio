   "lines": [
    {
     "id": "D1",
     "who": "patient",
     "text": "Doctor, why does my chest burn after dinner?",
     "emotion": "sick",
     "pose": "heart",
     "key": "burn"
    },
    {
     "id": "D2",
     "who": "doctor",
     "text": "That's heartburn: stomach acid travelling up toward your throat.",
     "emotion": "neutral",
     "pose": "explain",
     "key": "heartburn",
     "react": {
      "patient": "shocked"
     },
     "src": [
      "nhs-heartburn"
     ]
    },
    {
     "id": "D3",
     "who": "doctor",
     "text": "But here's the twist: the problem is a door. Your stomach's valve relaxes when it shouldn't.",
     "emotion": "happy",
     "pose": "present",
     "key": "twist",
     "src": [
      "niddk-gerd"
     ]
    },
    {
     "id": "D4",
     "who": "patient",
     "text": "And lying down makes it worse?",
     "emotion": "neutral",
     "pose": "think",
     "key": "worse"
    },
    {
     "id": "D5",
     "who": "doctor",
     "text": "Yes. So no food for three or four hours before bed.",
     "emotion": "happy",
     "pose": "thumb",
     "key": "hours",
     "src": [
      "nhs-heartburn"
     ]
    },
    {
     "id": "D6",
     "who": "doctor",
     "text": "And raise the head of your bed ten to twenty centimetres.",
     "emotion": "neutral",
     "pose": "point",
     "key": "raise",
     "react": {
      "patient": "happy"
     },
     "src": [
      "nhs-heartburn"
     ]
    }
